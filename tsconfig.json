{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "esnext",
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "noEmit": true,
    "noEmitHelpers": true,
    "importHelpers": true,
    "moduleResolution": "node",
    "noImplicitReturns": false,
    "noImplicitThis": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src", "src/types"],
  "exclude": ["node_modules"]
}